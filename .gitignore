# ---------------------------------------------------------------------------
# Patela monorepo
#   mobile/   Flutter app
#   backend/  Flask API
# ---------------------------------------------------------------------------

# Miscellaneous
*.class
*.log
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# ---- Flutter / Dart / Pub (mobile/) ----
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/mobile/build/
/mobile/coverage/
# Golden-test failure output
/mobile/test/failures/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/mobile/android/app/debug
/mobile/android/app/profile
/mobile/android/app/release

# Mobile environment config (real values) — keep the .example templates only
/mobile/env/*.json
!/mobile/env/*.json.example

# ---- Python / Flask (backend/) ----
__pycache__/
*.pyc
*.pyo
.venv/
venv/
# Backend secrets and local databases
/backend/.env
/backend/*.db
/backend/instance/
.pytest_cache/
