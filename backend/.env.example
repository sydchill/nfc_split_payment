# Copy to .env and fill in. Never commit .env.

# Postgres connection (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://patela:patela@localhost:5432/patela

# Secrets — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Access token lifetime in minutes (refresh tokens last 30 days)
JWT_ACCESS_MINUTES=60

# Comma-separated allowed origins for CORS (web clients only; mobile ignores CORS)
CORS_ORIGINS=*

# Google Sign-In — the WEB OAuth client id from Google Cloud Console.
# This is the audience of the ID token the mobile app sends. Leave blank to
# disable Google sign-in (the endpoint then returns 503).
# Comma-separate to accept more than one: append the ANDROID client id if you
# enable the app's browser fallback, whose tokens carry that id as audience.
# The client *secret* is never needed here — nothing in this app uses it.
GOOGLE_CLIENT_ID=

FLASK_ENV=development
